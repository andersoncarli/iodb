import { JsonCollection } from './30-json.js'
import { join } from 'path'

test('JSON Adapter: Basic operations', async () => {
    await withTempDir(async (tmp) => {
        const fp = join(tmp, 'test.json')
        const db = JsonCollection(fp)
        
        db.in({ foo: 'bar' }).flush()
        expect(db.get().foo).toBe('bar')
        
        const db2 = JsonCollection(fp)
        expect(db2.get().foo).toBe('bar')
    })
})
<!-- slide -->
import { SqliteCollection } from './50-sqlite.js'
import { join } from 'path'

test('SQLite Adapter: Basic operations', async () => {
    await withTempDir(async (tmp) => {
        const fp = join(tmp, 'test.db')
        const db = SqliteCollection(fp)
        
        // SQLite adapter typically handles JSON projections to table
        db.in({ key: 'config', value: { theme: 'dark' } }).flush()
        
        const db2 = SqliteCollection(fp)
        // Note: SQLite implementation might vary in how it projects to JS objects
        // This test verifies it doesn't crash and holds basic state
        expect(db2.get()).toBeDefined()
    })
})
